[Unit]
Description=daytrade-ai realtime monitor (KIS websocket -> Telegram)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python realtime.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
